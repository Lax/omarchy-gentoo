#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.
# Gentoo port: checkupdates -> a --pretend upgrade of the meta pair against
# the already-synced repositories. The dev-checkout git block is upstream
# verbatim.

set -euo pipefail

updates=()

if [[ ${OMARCHY_PATH:-/usr/share/omarchy} != "/usr/share/omarchy" ]]; then
  OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
  upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$OMARCHY_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$OMARCHY_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("omarchy-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

# Stable: pretend-upgrade the pair; portage prints [ebuild U] when the best
# visible version is newer, and [ebuild N] when the pair is not installed yet.
line=$(emerge --pretend --quiet --update app-misc/omarchy 2>/dev/null | grep -E '\[ebuild [^]]*[UN]' || true)

if [[ -n $line ]]; then
  updates+=("$line")
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Omarchy is up to date"
  exit 1
fi

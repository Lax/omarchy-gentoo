#!/bin/bash

# omarchy:summary=Returns true if the AUR is up and available.
# Gentoo port: there is no AUR. Third-party ebuilds come from overlays
# (eselect repository); report unavailable so callers degrade gracefully.

echo "The AUR does not exist on Gentoo." >&2
echo "Install from overlays instead: 'eselect repository enable <name>' then emerge." >&2
exit 1

SKIP_CLASS_LABELS = [
    ("in-gentoo", "already in ::gentoo"),
    ("arch-only", "Arch-only payload"),
    ("blocked", "blocked, with cause"),
    ("wave3", "planned, later wave"),
]


def die(msg):
    print(f"site-build: {msg}", file=sys.stderr)
    sys.exit(1)


def render_markdown(text):
    sys.path.insert(0, str(SITE / "vendor"))
    try:
        import markdown
    except ImportError:
        die("the vendored python-markdown is missing under site/vendor/")
    return markdown.markdown(
        text,
        extensions=[
            "markdown.extensions.fenced_code",
            "markdown.extensions.tables",
            "markdown.extensions.toc",
        ],
    )


# ---------------------------------------------------------------------------
# data gathering (all counts come from the tree, never from prose)
# ---------------------------------------------------------------------------

def read_tsv(path, columns):
    rows = []
    for line in (ROOT / path).read_text().splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) != columns:
            die(f"{path}: expected {columns} tab-separated columns, got {len(fields)}: {line!r}")
        rows.append(tuple(fields))
    return rows


def coverage():
    """Shipped and skipped, straight from the bookkeeping tables: shipped
    = packages.tsv rows (each must have its ebuild directory — the
    tooling gate enforces both directions, so a miss is a real
    inconsistency, not a transient state); skipped = gentoo-skip.tsv."""
    shipped = []
    for arch, category, gname in read_tsv("helpers/gentoo-packages.tsv", 3):
        pkgdir = ROOT / "gentoo" / category / gname
        if not pkgdir.is_dir() or not list(pkgdir.glob("*.ebuild")):
            die(f"packages.tsv row {arch} -> {category}/{gname} has no ebuild")
        shipped.append((arch, category, gname))
    return shipped, read_tsv("helpers/gentoo-skip.tsv", 3)


_AI_PORT_QUEUE = None


def port_queue():
    """The open port queue, parsed from `bin/ai-port --list-open` itself.
    Not recomputed here on purpose: ai-port owns the classification rules
    (package classes, per-PKGBUILD scope), and a second implementation in
    this script would drift from it."""
    global _AI_PORT_QUEUE
    if _AI_PORT_QUEUE is None:
        run = subprocess.run(
            ["bin/ai-port", "--list-open"], cwd=ROOT, capture_output=True, text=True
        )
        if run.returncode != 0:
            die(f"bin/ai-port --list-open failed: {run.stderr.strip()[:300]}")
        _AI_PORT_QUEUE = [
            fields[1]
            for line in run.stdout.splitlines()
            if line.rstrip().endswith("OPEN")
            for fields in [line.split()]
            if len(fields) >= 2
        ]
    return _AI_PORT_QUEUE


def upstream_pin():
    """The pinned omarchy-pkgs commit and its date, straight from git."""
    ls = subprocess.run(
        ["git", "ls-tree", "HEAD", "omarchy-pkgs"], cwd=ROOT, capture_output=True, text=True
    )
    if ls.returncode != 0:
        die(f"git ls-tree failed: {ls.stderr.strip()}")
    sha = ls.stdout.split()[2]
    log = subprocess.run(
        ["git", "log", "-1", "--format=%cs", "--", "omarchy-pkgs"],
        cwd=ROOT, capture_output=True, text=True,
    )
    if log.returncode != 0:
        die(f"git log failed: {log.stderr.strip()}")
    return sha[:12], log.stdout.strip()


def parse_changelog():
    text = (ROOT / "CHANGELOG.md").read_text()
    parts = re.split(r"^## (\d{4}-\d{2})\n", text, flags=re.M)
    preamble = parts[0].strip()
    if preamble.startswith("# "):
        preamble = preamble.split("\n", 1)[1].strip()
    months = list(zip(parts[1::2], parts[2::2]))
    if not months:
        die("CHANGELOG.md has no '## YYYY-MM' sections")
    return preamble, months


# ---------------------------------------------------------------------------
# generated fragments (the site's anti-drift core: data rendered at build
# time from the same files the gates check)
# ---------------------------------------------------------------------------

def generate_status(zh=False):
    shipped, skipped = coverage()
    sha, date = upstream_pin()
    if zh:
        stats = [
            (str(len(shipped)), "已移植的包"),
            (str(len(skipped)), "有因跳过"),
            (str(len(port_queue())), "移植队列待办"),
        ]
        pin = (
            f'跟踪上游 <code>omacom/omarchy-pkgs</code> '
            f'<a href="{REPO_URL}/commit/{sha}"><code>{sha}</code></a>（{date}），'
            f"每次变更自动发布到 overlay。"
        )
    else:
        stats = [
            (str(len(shipped)), "packages shipped"),
            (str(len(skipped)), "skipped, with cause"),
            (str(len(port_queue())), "open in the port queue"),
        ]
        pin = (
            f'tracking upstream <code>omacom/omarchy-pkgs</code> '
            f'<a href="{REPO_URL}/commit/{sha}"><code>{sha}</code></a> ({date}), '
            f"republished to the overlay on every change."
        )
    cells = "".join(
        f'<div class="stat"><span class="stat-n">{n}</span><span class="stat-l">{l}</span></div>'
        for n, l in stats
    )
    return f'<div class="status-strip">{cells}</div>\n<p class="status-pin">{pin}</p>'


def generate_packages():
    shipped, skipped = coverage()
    backlog = port_queue()
    out = ['<div class="coverage">']

    out.append(f'<h2 id="shipped">Shipped ({len(shipped)})</h2>')
    out.append(
        "<p>Every Arch package with a Gentoo ebuild, by category. Links go to "
        "the ebuild directory in the development tree, which is exactly what "
        "CI republishes to the overlay.</p>"
    )
    by_category = {}
    for arch, category, gname in shipped:
        by_category.setdefault(category, []).append((arch, gname))
    for category in sorted(by_category):
        out.append(f'<h3 id="cat-{category}">{html.escape(category)}</h3>')
        out.append('<div class="pkg-table">')
        for arch, gname in sorted(by_category[category]):
            href = f"{REPO_URL}/tree/master/gentoo/{category}/{gname}"
            atom = f"{category}/{gname}"
            same = "" if arch == gname else f" <span class=\"pkg-arch-name\">(arch: {html.escape(arch)})</span>"
            out.append(
                f'<div class="pkg-row"><a href="{href}">{html.escape(atom)}</a>{same}</div>'
            )
        out.append("</div>")

    out.append(f'<h2 id="skipped">Intentionally skipped ({len(skipped)})</h2>')
    out.append(
        "<p>Arch packages deliberately not ported, each with its cause — a "
        "package listed here never shows up as missing work (the nightly "
        "coverage job reads the same table).</p>"
    )
    for klass, label in SKIP_CLASS_LABELS:
        rows = [(n, r) for n, k, r in skipped if k == klass]
        if not rows:
            continue
        out.append(f"<h3>{html.escape(label)} ({len(rows)})</h3>")
        out.append('<dl class="skip-list">')
        for name, reason in rows:
            out.append(f"<dt><code>{html.escape(name)}</code></dt><dd>{html.escape(reason)}</dd>")
        out.append("</dl>")

    out.append(f'<h2 id="backlog">Open in the port queue ({len(backlog)})</h2>')
    out.append(
        "<p>Upstream recipes with neither an ebuild nor a skip entry — the "
        "live porting queue, identical to what <code>bin/ai-port --list-open</code> "
        "reports and what the nightly backlog issue carries.</p>"
    )
    if backlog:
        out.append('<p class="backlog-list">')
        out.append(", ".join(f"<code>{html.escape(name)}</code>" for name in backlog))
        out.append("</p>")
    else:
        out.append("<p>Nothing open: every upstream recipe ships or has a documented cause.</p>")
    out.append("</div>")
    return "\n".join(out) + "\n"


def generate_news():
    _, months = parse_changelog()
    out = ['<div class="news">']
    for month, body in months:
        out.append(f'<section class="news-month" id="{month}">')
        out.append(f"<h2>{month}</h2>")
        out.append(render_markdown(body.strip()))
        out.append("</section>")
    out.append("</div>")
    return "\n".join(out) + "\n"


def generate_news_preview(limit):
    """The newest changelog month's first bullets, for the landing."""
    _, months = parse_changelog()
    month, body = months[0]
    bullets = [line for line in body.splitlines() if line.startswith("- ")][:limit]
    if not bullets:
        die("CHANGELOG.md newest month has no bullet entries")
    return (
        '<div class="news-preview">'
        f'<p class="news-preview-head">Latest — <a href="news/">{month}</a>:</p>\n'
        + render_markdown("\n".join(bullets))
        + "</div>"
    )


# ---------------------------------------------------------------------------
# directives & page rendering
# ---------------------------------------------------------------------------

INCLUDE_RE = re.compile(r"^@@include (.+?)@@\s*$", re.M)
DIRECTIVE_RE = re.compile(r"^@@generated:([a-z-]+)(?: (\d+))?@@\s*$", re.M)


def include_body(path):
    """Render a repo file into a page, minus the parts that only make
    sense inside its own repository: the <picture> header block and the
    trailing Provenance section (its relative links are overlay-repo
    specific; the site covers provenance in About and Developing)."""
    text = (ROOT / path).read_text()
    text = re.sub(r"\A<h1\b.*?</h1>\s*", "", text, flags=re.S)
    cut = text.find("\n## Provenance\n")
    if cut == -1:
        die(f"{path}: expected a '## Provenance' section to cut at the site boundary")
    return text[:cut].rstrip() + "\n"


def apply_directives(text, page_src):
    def include(match):
        path = match.group(1)
        if not (ROOT / path).is_file():
            die(f"{page_src}: @@include {path}@@ — no such file")
        return include_body(path)

    def directive(match):
        kind, arg = match.group(1), match.group(2)
        if kind == "packages":
            return generate_packages()
        if kind == "news":
            return generate_news()
        if kind == "status":
            return generate_status()
        if kind == "status-zh":
            return generate_status(zh=True)
        if kind == "news-preview":
            return generate_news_preview(int(arg or 3))
        die(f"{page_src}: unknown @@generated:{kind}@@ directive")

    text = INCLUDE_RE.sub(include, text)
    return DIRECTIVE_RE.sub(directive, text)


def parse_frontmatter(text, src):
    if not text.startswith("---\n"):
        die(f"{src}: missing frontmatter (--- title: ... ---)")
    end = text.find("\n---\n", 4)
    if end == -1:
        die(f"{src}: unterminated frontmatter")
    meta, body = {}, text[end + 5:]
    for line in text[4:end].splitlines():
        if ": " not in line:
            die(f"{src}: bad frontmatter line {line!r}")
        key, value = line.split(": ", 1)
        meta[key.strip()] = value.strip()
    if "title" not in meta:
        die(f"{src}: frontmatter needs a title")
    meta.setdefault("desc", DEFAULT_DESC)
    return meta, body


def page_prefix(out_path):
    """Relative prefix from a page's directory to the site root."""
    page_dir = posixpath.dirname(out_path)
    if not page_dir:
        return ""
    rel = posixpath.relpath(".", page_dir)
    return "" if rel == "." else rel + "/"


def nav_html(out_path, prefix):
    # The topbar chrome stays English in both locales; the targets follow
    # the locale when the page is translated, else they fall back to the
    # English page (marked implicitly by the sidebar's EN tags).
    zh = out_path.startswith("zh/")
    targets = [
        ("Home", "zh/index.html" if zh else "index.html", False),
        ("Manual", "zh/manual/index.html" if zh else "manual/index.html", False),
        ("Packages", "manual/packages/index.html", False),
        ("News", "news/index.html", False),
        ("Developing", "manual/developing/index.html", False),
        (
            "Install",
            "zh/manual/install/index.html" if zh else "manual/install/index.html",
            True,
        ),
    ]
    items = []
    for label, target, button in targets:
        active = (
            posixpath.dirname(out_path) == posixpath.dirname(target)
            and out_path != "404.html"
        )
        cls = (["nav-button"] if button else []) + (["active"] if active else [])
        attr = f' class="{" ".join(cls)}"' if cls else ""
        dir_part = posixpath.dirname(target)
        href = f"{prefix}{dir_part}/" if dir_part else prefix or "."
        items.append(f'<a href="{href}"{attr}>{label}</a>')
    items.append('<a class="nav-ext" href="https://github.com/Lax/omarchy-gentoo">GitHub&#8599;</a>')
    items.append(lang_switch_html(out_path))
    items.append(
        '<button id="theme-toggle" type="button" title="Cycle theme (T)" '
        'aria-label="Cycle theme">&#9686;</button>'
    )
    return "\n".join(items)


def site_url_for(out_path):
    return f"{SITE_URL}/{posixpath.dirname(out_path)}/"


def lang_switch_html(out_path):
    """EN | 中文 — only on the pages of a translation pair; the current
    locale is the inert half of the pair."""
    if out_path in ZH_OF:
        other, other_label, this_label = ZH_OF[out_path], "中文", "EN"
    else:
        en = next((en for en, z in ZH_OF.items() if z == out_path), None)
        if not en:
            return ""
        other, other_label, this_label = en, "EN", "中文"
    page_dir = posixpath.dirname(out_path)
    href = posixpath.relpath(posixpath.dirname(other) or ".", page_dir or ".")
    return (
        f'<span class="lang-switch"><span class="lang-current">{this_label}</span>'
        f'<a href="{href}/">{other_label}</a></span>'
    )


def alternates_html(out_path):
    """hreflang pair links (absolute, per the spec) for translated pages."""
    zh = ZH_OF.get(out_path) or next(
        (z for en, z in ZH_OF.items() if z == out_path), None
    )
    if not zh:
        return ""
    en = out_path if ZH_OF.get(out_path) else next(
        en for en, z in ZH_OF.items() if z == out_path
    )
    return (
        f'<link rel="alternate" hreflang="en" href="{site_url_for(en)}">\n'
        f'<link rel="alternate" hreflang="zh" href="{site_url_for(zh)}">\n'
        f'<link rel="alternate" hreflang="x-default" href="{site_url_for(en)}">'
    )


def hero_html(out_path, prefix):
    if out_path == "index.html":
        tag = "The Omarchy desktop for Gentoo Linux — Hyprland, quickshell\n  and the tools around them — as source-based ebuilds."
        badge = "an unofficial community overlay · not affiliated with upstream Omarchy"
    elif out_path == "zh/index.html":
        tag = "为 Gentoo Linux 带来 Omarchy 桌面 —— Hyprland、quickshell\n  以及围绕它们的工具，全部是源码构建的 ebuild。"
        badge = "非官方社区 overlay · 与上游 Omarchy 无隶属关系"
    else:
        return ""
    return f"""<div class="hero">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="{prefix}assets/omarchy-gentoo-lockup-dark.svg">
    <img src="{prefix}assets/omarchy-gentoo-lockup-light.svg" alt="Omarchy on Gentoo — Omarchy packages for Gentoo Linux" width="640">
  </picture>
  <p class="hero-tag">{tag}</p>
  <p class="hero-badge">{badge}</p>
</div>"""


def breadcrumb(out_path, prefix):
    zh = out_path.startswith("zh/manual/")
    if not out_path.startswith("manual/") and not zh:
        return ""
    if out_path in ("manual/index.html", "zh/manual/index.html"):
        return ""
    href = f"{prefix}zh/manual/" if zh else f"{prefix}manual/"
    return f'<p class="crumb"><a href="{href}">manual</a> · the manual</p>\n'


def sidebar_html(out_path, prefix):
    """The manual's left sidebar (upstream's manual layout): the ordered
    page list with the current page marked. Manual pages only. On zh
    pages the translated entries come from the zh tree; untranslated
    ones link to the English page with an EN tag."""
    zh = out_path.startswith("zh/manual/")
    if not out_path.startswith("manual/") and not zh:
        return ""
    zh_labels = {
        "about": "关于",
        "install": "安装",
        "packages": "包覆盖",
        "differences": "差异",
        "troubleshooting": "排障",
        "faq": "FAQ",
        "themes": "主题",
        "plugins": "插件",
        "developing": "开发",
    }
    items = []
    for _, slug, label in MANUAL_PAGES:
        if zh:
            translated = slug in ZH_MANUAL_SLUGS
            # prefix is relative to the site root from the zh page, so the
            # English fallback uses the same shape as any en page.
            href = f"{prefix}{'zh/manual/' if translated else 'manual/'}{slug}/"
            text = zh_labels[slug] + ("" if translated else ' <span class="en-tag">EN</span>')
            active = out_path == f"zh/manual/{slug}/index.html"
        else:
            href, text, active = f"{prefix}manual/{slug}/", label, False
            active = out_path == f"manual/{slug}/index.html"
        marked = ' class="active"' if active else ""
        items.append(f'<li{marked}><a href="{href}">{text}</a></li>')
    title_href = f"{prefix}zh/manual/" if zh else f"{prefix}manual/"
    return (
        '<aside class="sidebar" aria-label="Manual sections">\n'
        f'<p class="sidebar-title"><a href="{title_href}">the manual</a></p>\n'
        "<ol>\n" + "\n".join(items) + "\n</ol>\n</aside>"
    )


def en_revision(en_src):
    return hashlib.sha256((SITE / en_src).read_bytes()).hexdigest()[:16]


def stale_translations():
    """zh pages whose en-stamp predates the current English source —
    the self-test reports them loudly and the pages carry the banner;
    neither blocks a deploy (the banner is the visible signal)."""
    stale = []
    for zh_out, (zh_src, en_src) in sorted(ZH_SOURCE_OF.items()):
        text = (SITE / zh_src).read_text()
        m = re.search(r"^en-stamp: ([0-9a-f]+)$", text, re.M)
        expected = en_revision(en_src)
        if not m or m.group(1) != expected:
            stale.append((zh_src, expected))
    return stale


def staleness_banner(zh_src, en_src, prefix):
    text = (SITE / zh_src).read_text()
    m = re.search(r"^en-stamp: ([0-9a-f]+)$", text, re.M)
    if m and m.group(1) == en_revision(en_src):
        return ""
    en_out = next(out for src, out in PAGES if src == en_src)
    en_href = f"{prefix}{posixpath.dirname(en_out)}/"
    return (
        '<div class="i18n-stale">本翻译可能已过期：英文原页在此翻译之后有更新，'
        f'以 <a href="{en_href}">英文页</a> 为准。</div>'
    )


def substitute(template, out_path, title, desc, content, base):
    year = max(m for m, _ in parse_changelog()[1])[:4]
    # The landing title carries the site name itself; everywhere else the
    # page title gets the site name appended.
    if out_path not in ("index.html", "zh/index.html"):
        title = f"{title} · Omarchy on Gentoo"
    # The 404 is served at the missing URL: its links must be absolute.
    prefix = base if out_path == "404.html" else page_prefix(out_path)
    if out_path.startswith("zh/"):
        zh_src, en_src = ZH_SOURCE_OF[out_path]
        banner = staleness_banner(zh_src, en_src, prefix)
        content = f"{banner}\n{content}" if banner else content
    return (
        template.replace("{{base}}", base)
        .replace("{{prefix}}", prefix)
        .replace("{{title}}", html.escape(title))
        .replace("{{desc}}", html.escape(desc))
        .replace("{{alternates}}", alternates_html(out_path))
        .replace("{{nav}}", nav_html(out_path, prefix))
        .replace("{{hero}}", hero_html(out_path, prefix))
        .replace("{{crumb}}", breadcrumb(out_path, prefix))
        .replace("{{sidebar}}", sidebar_html(out_path, prefix))
        .replace(
            "{{home_class}}",
            "page-home"
            if out_path in ("index.html", "zh/index.html")
            else "page-manual"
            if out_path.startswith(("manual/", "zh/manual/"))
            else "page-doc",
        )
        .replace("{{year}}", year)
        .replace("{{content}}", content)
    )


def render_page(src, out_path, template, base):
    text = (ROOT / "site" / src).read_text()
    meta, body = parse_frontmatter(text, src)
    content = apply_directives(body, src)
    return substitute(template, out_path, meta["title"], meta["desc"], render_markdown(content), base)


def copy_assets():
    dest = DIST / "assets"
    dest.mkdir(parents=True, exist_ok=True)
    for name in ASSETS:
        src = ROOT / "assets" / "logo" / name
        if not src.is_file():
            die(f"assets/logo/{name} is missing — the logo kit changed; update bin/site-build ASSETS")
        (dest / name).write_bytes(src.read_bytes())
    for name in ("site.css", "site.js"):
        (dest / name).write_bytes((SITE / "template" / name).read_bytes())


def link_check(base):
    """Every internal href/src must resolve to an emitted file; every
    fragment to an emitted id. Absolute internal paths are rejected
    (they break under the Pages subpath) except on the base-prefixed
    404, whose absolutes are the point."""
    problems = []
    for page in sorted(DIST.rglob("*.html")):
        text = page.read_text()
        rel = str(page.relative_to(DIST))
        page_dir = posixpath.dirname(rel)
        for url in re.findall(r'\b(?:href|src)="([^"]+)"', text):
            if url.startswith(("http://", "https://", "mailto:")):
                continue
            target, _, fragment = url.partition("#")
            if not target:
                if fragment and f'id="{fragment}"' not in text:
                    problems.append(f"{rel}: dead fragment #{fragment}")
                continue
            if target.startswith("/"):
                # Absolute paths are the 404's contract (it is served at
                # the missing URL); everywhere else they would break under
                # the Pages subpath.
                if base and target.startswith(base):
                    target = target[len(base):]
                elif rel != "404.html":
                    problems.append(f"{rel}: absolute internal link {url} (breaks under a subpath)")
                    continue
                resolved = posixpath.normpath(target).lstrip("/")
            else:
                resolved = posixpath.normpath(posixpath.join(page_dir, target))
            candidates = [resolved, posixpath.join(resolved, "index.html")]
            hit = next((c for c in candidates if (DIST / c).is_file()), None)
            if hit is None:
                problems.append(f"{rel}: dead link {url}")
            elif fragment and f'id="{fragment}"' not in (DIST / hit).read_text():
                problems.append(f"{rel}: dead fragment {url}")
    return problems


def build(outdir):
    global DIST
    DIST = Path(outdir)
    base = os.environ.get("OMARCHY_SITE_BASE", "")
    if base and not (base.startswith("/") and base.endswith("/")):
        die("OMARCHY_SITE_BASE must be empty or look like /omarchy-gentoo/")
    template = (SITE / "template" / "base.html").read_text()
    for src, out_path in ALL_PAGES:
        target = DIST / out_path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(render_page(src, out_path, template, base))
    # The 404 page: same pipeline, absolute (base-prefixed) links.
    src = "content/404.md"
    text = (ROOT / "site" / src).read_text()
    meta, body = parse_frontmatter(text, src)
    content = render_markdown(apply_directives(body, src))
    (DIST / "404.html").write_text(
        substitute(template, "404.html", meta["title"], meta["desc"], content, base)
    )
    copy_assets()
    (DIST / ".nojekyll").write_text("")
    for zh_src, _ in stale_translations():
        print(f"site-build: STALE TRANSLATION {zh_src} — the English page moved after it", file=sys.stderr)
    problems = link_check(base)
    if problems:
        for p in problems:
            print(f"site-build: {p}", file=sys.stderr)
        die(f"{len(problems)} broken internal link(s) — fix the sources")


def tree_digest(root):
    import hashlib

    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        digest.update(str(path.relative_to(root)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


# ---------------------------------------------------------------------------
# self-test
# ---------------------------------------------------------------------------

def self_test():
    checks = []

    def check(name, condition, detail=""):
        checks.append((name, bool(condition), detail))
        if not condition:
            print(f"FAIL {name} {detail}", file=sys.stderr)

    # 1. deterministic: two builds of the same tree are byte-identical
    with tempfile.TemporaryDirectory() as tmp:
        one, two = Path(tmp) / "one", Path(tmp) / "two"
        build(one)
        build(two)
        check("builds are deterministic", tree_digest(one) == tree_digest(two))

        index = (one / "index.html").read_text()
        install = (one / "manual" / "install" / "index.html").read_text()
        packages = (one / "manual" / "packages" / "index.html").read_text()
        news = (one / "news" / "index.html").read_text()

        # 2. no unsubstituted template placeholders anywhere
        leaks = [str(p.relative_to(one)) for p in one.rglob("*.html") if "{{" in p.read_text()]
        check("no template placeholder leaks", not leaks, str(leaks))

        # 3. the install page carries the canonical commands from the
        #    overlay README (single source: the include), minus the
        #    overlay-repo-only sections
        check(
            "install include carries the eselect line",
            "eselect repository add omarchy git https://github.com/Lax/omarchy-overlay.git" in install,
        )
        check(
            "install include carries both emerge targets",
            "emerge omarchy/omarchy" in install and "emerge omarchy/omarchy-base" in install,
        )
        check("install include strips the picture header", "<picture>" not in install)
        check("install include strips Provenance", "## Provenance" not in install)

        # 4. the generated coverage page agrees with the tools: shipped
        #    and skipped come from the tables, the queue comes from
        #    bin/ai-port itself (same source the nightly coverage job uses)
        shipped, skipped = coverage()
        check(
            "packages page renders the shipped count",
            f'<h2 id="shipped">Shipped ({len(shipped)})</h2>' in packages,
        )
        check(
            "packages page renders the skip table",
            "spotify" in packages and "slack-desktop" in packages,
        )
        queue = port_queue()
        raw = subprocess.run(
            ["bin/ai-port", "--list-open"], cwd=ROOT, capture_output=True, text=True
        )
        check("ai-port --list-open runs", raw.returncode == 0, raw.stderr[:200])
        raw_open = sum(1 for line in raw.stdout.splitlines() if line.rstrip().endswith("OPEN"))
        check(
            "port queue parses ai-port's output fully",
            raw_open == len(queue),
            f"raw output has {raw_open} OPEN lines, parsed {len(queue)}",
        )
        for name in queue:
            check(f"packages page lists queue entry {name}", f"<code>{name}</code>" in packages)

        # 5. news renders every changelog month
        for month, _ in parse_changelog()[1]:
            check(f"news renders {month}", f'id="{month}"' in news)

        # 6. no hand-written package counts in content files (numbers come
        #    from build-time interpolation, never from prose)
        offenders = [
            src for src, _ in ALL_PAGES
            if re.search(r"\b\d+\s+(?:packages|ebuilds)\b", (ROOT / "site" / src).read_text())
        ]
        check("no hard-coded counts in content", not offenders, str(offenders))

        # 7. invariant greps: facts the pages must keep stating
        for src, needles in INVARIANTS.items():
            page_text = (ROOT / "site" / src).read_text()
            for needle in needles:
                check(f"{src} states {needle!r}", needle in page_text)

        # 8. the landing carries the generated status strip
        check("landing renders the status strip", 'class="status-strip"' in index)

        # 8b. the manual sidebar: present on manual pages (with the current
        #     page marked), absent elsewhere
        for _, slug, _ in MANUAL_PAGES:
            page_html = (one / "manual" / slug / "index.html").read_text()
            check(
                f"manual/{slug} has a sidebar",
                'class="sidebar"' in page_html
                and f'<li class="active"><a href="../../manual/{slug}/">' in page_html,
            )
        manual_toc = (one / "manual" / "index.html").read_text()
        check(
            "manual TOC has a sidebar without an active entry",
            'class="sidebar"' in manual_toc and '<li class="active">' not in manual_toc,
        )
        check("landing has no sidebar", 'class="sidebar"' not in index)
        check("news has no sidebar", 'class="sidebar"' not in news)

        # 8c. the zh subset: pairs link each way (hreflang + switcher),
        #     the zh landing carries zh status labels, and the zh sidebar
        #     tags the untranslated pages
        zh_install = (one / "zh" / "manual" / "install" / "index.html").read_text()
        zh_landing = (one / "zh" / "index.html").read_text()
        check("en install hreflangs zh", 'hreflang="zh"' in install and 'hreflang="x-default"' in install)
        check("zh install hreflangs en", 'hreflang="en"' in zh_install)
        check("en install carries the lang switch", 'class="lang-switch"' in install)
        check("zh install carries the lang switch", 'class="lang-switch"' in zh_install)
        check("packages page has no lang switch", 'class="lang-switch"' not in packages)
        check("zh landing renders zh status labels", "已移植的包" in zh_landing)
        check("zh landing has no news preview", "news-preview" not in zh_landing)
        check("zh install has a sidebar", 'class="sidebar"' in zh_install)
        check(
            "zh sidebar tags untranslated entries EN",
            '<span class="en-tag">EN</span>' in zh_install,
        )
        check(
            "zh sidebar marks the active entry",
            '<li class="active"><a href="../../../zh/manual/install/">' in zh_install,
        )

    # 9. the OMARCHY_SITE_BASE variant: 404 absolutes get the base, the
    #    other pages stay root-relative (subpath-safe)
    os.environ["OMARCHY_SITE_BASE"] = "/omarchy-gentoo/"
    try:
        with tempfile.TemporaryDirectory() as tmp:
            three = Path(tmp) / "three"
            build(three)
            p404 = (three / "404.html").read_text()
            check("404 links carry the base path", 'href="/omarchy-gentoo/manual/' in p404)
            regular = (three / "manual" / "install" / "index.html").read_text()
            check(
                "regular pages stay root-relative",
                'href="/' not in regular and 'src="/' not in regular,
            )
    finally:
        os.environ.pop("OMARCHY_SITE_BASE", None)

    # 10. the vendored renderer is a real python-markdown 3.x
    sys.path.insert(0, str(SITE / "vendor"))
    import markdown

    check("vendored markdown imports", markdown.__version__.startswith("3."))

    # 11. translation stamps: structural problems fail; a moved English
    #     source warns loudly (the banner ships, the deploy proceeds,
    #     and this line keeps the debt visible on every run)
    for zh_out, (zh_src, en_src) in sorted(ZH_SOURCE_OF.items()):
        text = (SITE / zh_src).read_text()
        if not re.search(r"^en-source: content/", text, re.M):
            check(f"translation declares en-source: {zh_src}", False)
        if not re.search(r"^en-stamp: [0-9a-f]{16}$", text, re.M):
            check(
                f"translation carries a well-formed en-stamp: {zh_src}",
                False,
                f"(expected en-stamp: {en_revision(en_src)})",
            )
    for zh_src, expected in stale_translations():
        print(
            f"site-build: STALE TRANSLATION {zh_src} — English moved after it; "
            f"reconcile the page, then run: bin/site-build --stamp-zh "
            f"(this en revision stamps as {expected})",
            file=sys.stderr,
        )

    failed = [name for name, ok, _ in checks if not ok]
    print(f"site-build self-test: {len(checks) - len(failed)}/{len(checks)} checks passed")
    if failed:
        sys.exit(1)


def main():
    if "--self-test" in sys.argv[1:]:
        self_test()
        return
    if "--stamp-zh" in sys.argv[1:]:
        # Refresh the translation stamps: the honest reading is "the
        # English source was reviewed against this translation after it
        # changed", so run it after actually reconciling the zh pages.
        for zh_out, (zh_src, en_src) in sorted(ZH_SOURCE_OF.items()):
            path = SITE / zh_src
            text = path.read_text()
            new = re.sub(
                r"^en-stamp: [0-9a-f]*$",
                f"en-stamp: {en_revision(en_src)}",
                text,
                flags=re.M,
            )
            path.write_text(new)
            print(f"site-build: stamped {zh_src} @ {en_revision(en_src)}")
        return
    if len(sys.argv) > 1:
        die(f"unknown argument {sys.argv[1]!r} (try --self-test)")
    build(DIST)
    print(f"site-build: wrote {DIST}")


if __name__ == "__main__":
    main()

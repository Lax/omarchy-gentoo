#!/usr/bin/env python3
"""bin/site-build -- build the omarchy-gentoo documentation site.

Markdown in, static HTML out. Zero network, zero package installs: the
only renderer is the vendored python-markdown under site/vendor/ (BSD-3,
see site/vendor/Markdown-LICENSE). Every number the site shows (package
counts, the upstream pin, the news entries) is generated at build time
from the same tree the gates verify, so the site cannot drift from the
overlay without the build failing first.

Usage:
    bin/site-build              build into site/dist/
    bin/site-build --self-test  offline checks; builds into a temp dir and
                                asserts everything the build promises

Environment:
    OMARCHY_SITE_BASE  absolute subpath the site is deployed under, e.g.
                       /omarchy-gentoo/ (leading+trailing slash). All page
                       links are root-relative and work under any subpath;
                       only the 404 page needs the base (GitHub Pages
                       serves it at the missing URL, so its links must be
                       absolute).
"""

import hashlib
import html
import os
import posixpath
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SITE = ROOT / "site"
DIST = SITE / "dist"
REPO_URL = "https://github.com/Lax/omarchy-gentoo"
# The canonical site URL, for hreflang alternates only (all page links
# are root-relative). One line to change if the domain ever moves.
SITE_URL = "https://liulantao.com/omarchy-gentoo"
DEFAULT_DESC = "The Omarchy desktop for Gentoo Linux, as a source-based ebuild overlay."

# Every markdown page: source file, output path. Manual pages carry their
# number in the source name (ordering + repo readability) and a clean slug
# in the URL (stable if pages reorder).
MANUAL_PAGES = [
    ("01-about.md", "about", "About"),
    ("02-install.md", "install", "Install"),
    ("03-packages.md", "packages", "Packages"),
    ("04-differences.md", "differences", "Differences from Arch Omarchy"),
    ("05-troubleshooting.md", "troubleshooting", "Troubleshooting"),
    ("06-faq.md", "faq", "FAQ"),
    ("08-themes.md", "themes", "Themes"),
    ("09-plugins.md", "plugins", "Plugins"),
    ("10-developing.md", "developing", "Developing"),
]
PAGES = [

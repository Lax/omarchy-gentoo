    for name, slug, _ in MANUAL_PAGES
    if slug in ZH_MANUAL_SLUGS
]
ALL_PAGES = PAGES + [(src, out) for src, out, _ in ZH_PAGES]
# zh output path -> (zh source, en source): the staleness stamp reads it.
ZH_SOURCE_OF = {zh_out: (zh_src, en_src) for zh_src, zh_out, en_src in ZH_PAGES}
# English output path -> its zh counterpart (the hreflang/switcher pairs).
ZH_OF = {
    "index.html": "zh/index.html",
    "manual/index.html": "zh/manual/index.html",
} | {
    f"manual/{slug}/index.html": f"zh/manual/{slug}/index.html"
    for slug in ZH_MANUAL_SLUGS
}
# The top navigation: label, output path it points at, styled as button.
NAV = [
    ("Home", "index.html", False),
    ("Manual", "manual/index.html", False),
    ("Packages", "manual/packages/index.html", False),
    ("News", "news/index.html", False),

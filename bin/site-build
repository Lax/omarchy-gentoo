    ("content/manual/00-index.md", "manual/index.html"),
] + [
    (f"content/manual/{name}", f"manual/{slug}/index.html")
    for name, slug, _ in MANUAL_PAGES
] + [
    ("content/news.md", "news/index.html"),
]

# The Chinese subset: English stays canonical, zh covers the pages a
# Chinese reader actually lands on (packages/news/developing stay
# English — data pages and the contributor page are language-neutral
# enough that a mirror would be translation for its own sake). Each zh
# page's frontmatter carries `en-source` + `en-stamp` (a hash of the
# English source at translation time); the self-test fails when the
# English page has moved since, so stale translations fail the build
# instead of lingering.
ZH_MANUAL_SLUGS = [

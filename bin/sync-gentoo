#!/bin/bash
# Reconcile the Gentoo overlay with the Arch recipes it was ported from.
#
# Deliberately independent of bin/sync-upstream: that tool (upstream's)
# bumps PKGBUILDs from vendor feeds; this tool notices the resulting drift
# on the Gentoo side and renames the affected ebuilds. Nothing else needs to
# change on a version bump - Manifests are regenerated by CI - except a
# pinned URL or commit inside the ebuild that still names the old release,
# which is flagged loudly for a human or agent to finish.
#
# Each ebuild carries a baseline marker in its header comment:
#
#   # arch-pkgver: <pkgver>
#
# The marker records which Arch version the ebuild corresponds to, so drift
# is decided by vercmp between Arch versions (the comparator the rest of
# this repo trusts), never by parsing Gentoo filenames, whose mangling rules
# (epoch dropping, letter folding) are lossy in that direction.
#
# Usage: sync-gentoo [PACKAGE...]     Rename drifted ebuilds (specific
#                                     packages, or every row in the table)
#        sync-gentoo --check          Report drift only; exit 1 if any
#        sync-gentoo --self-test
#
# Requirements: bash, vercmp (from pacman) for the upgrade-direction check.
# Without vercmp, a version difference is still reported, but its direction
# cannot be verified and sync mode refuses to rename (fail closed).
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
# Two roots: BUILD_ROOT is this management repo; upstream/ is the
# pinned submodule whose PKGBUILDs our tooling reconciles against.
UPSTREAM_ROOT="${OMARCHY_UPSTREAM:-$BUILD_ROOT/omarchy-pkgs}"
PKGBUILDS_DIR="${PKGBUILDS_DIR:-$UPSTREAM_ROOT/pkgbuilds}"
[[ -f "$UPSTREAM_ROOT/helpers/package-metadata.sh" ]] || {
	echo "error: upstream submodule not checked out under $UPSTREAM_ROOT; run: git submodule update --init" >&2
	exit 1
}
source "$UPSTREAM_ROOT/helpers/package-metadata.sh"
source "$BUILD_ROOT/helpers/gentoo.sh"

GENTOO_ROOT="$BUILD_ROOT/gentoo"

MARKER='# arch-pkgver:'

have_vercmp() { command -v vercmp >/dev/null 2>&1; }

marker_pkgver() {
	# <ebuild file> -> the Arch version in its marker ("" when absent)
	sed -n 's/^# arch-pkgver: *//p' "$1" | head -n 1
}

# <ebuild path> <arch-pkgdir> -> baseline Arch version of the ebuild, via the
# marker; without a marker, the current PKGBUILD version is adopted when the
# file name matches its mangling (the ebuild was written at this version),
# otherwise nothing can be derived.
baseline_of() {
	local ebuild="$1" pkgdir="$2" current_pv
	local marker
	marker=$(marker_pkgver "$ebuild")
	if [[ -n "$marker" ]]; then
		echo "$marker"
		return 0
	fi
	current_pv=$(package_pkgbuild_var "$pkgdir" pkgver || true)
	if [[ "$(gentoo_version "$current_pv")" == "$(basename "${ebuild%.ebuild}")" ]]; then
		echo "$current_pv"
		return 0
	fi
	return 1
}

sync_one() {
	# <arch-name> <category> <gname> <mode: check|sync>
	local package="$1" category="$2" gname="$3" mode="$4"
	local pkgdir="$PKGBUILDS_DIR/$package"
	local dir="$GENTOO_ROOT/$category/$gname"

	if [[ ! -d "$pkgdir" ]]; then
		echo "skip  $package: not present in the upstream submodule"
		return 0
	fi
	local ebuilds=("$dir"/"$gname"-*.ebuild)
	if [[ ! -e "${ebuilds[0]}" ]]; then
		echo "skip  $category/$gname: table row has no ebuild"
		return 0
	fi
	if (( ${#ebuilds[@]} > 1 )); then
		echo "skip  $category/$gname: multiple ebuilds, rename by hand"
		return 0
	fi
	local ebuild="${ebuilds[0]}"

	local baseline current_pv
	if ! baseline=$(baseline_of "$ebuild" "$pkgdir"); then
		echo "skip  $category/$gname: no arch-pkgver marker and file name does not match the current recipe"
		return 0
	fi
	current_pv=$(package_pkgbuild_var "$pkgdir" pkgver)
	[[ -n "$current_pv" ]] || {
		echo "skip  $category/$gname: could not read pkgver from the PKGBUILD"
		return 0
	}

	local force_rename=0
	if [[ "$baseline" == "$current_pv" ]]; then
		local name_version
		name_version="$(basename "${ebuild%.ebuild}")"
		name_version="${name_version#${gname}-}"
		if is_pms_version "$name_version"; then
			# Either the mechanical mangling or a deliberate hand-chosen name
			# (a dropped commit hash, a Gentoo -r bump) - portage can see it.
			echo "ok    $category/$gname at $baseline"
			return 0
		fi
		# The marker matches the recipe, but the ebuild's file name parses as
		# no PMS version at all (a rename that skipped gentoo_version, say),
		# so portage cannot see the package. That is drift even though the
		# version "matches".
		if [[ "$mode" == check ]]; then
			local want_pv
			want_pv=$(gentoo_version "$current_pv")
			echo "drift $category/$gname: file name does not mangle $baseline (expected $gname-$want_pv.ebuild)"
			DRIFT=1
			return 0
		fi
		force_rename=1
	fi

	local direction="?"
	if have_vercmp; then
		direction=$(vercmp "$current_pv" "$baseline")
	fi

	if [[ "$direction" == "<" || "$direction" == "-1" ]]; then
		echo "note  $category/$gname: recipe ($current_pv) is older than the ebuild's baseline ($baseline); leaving it alone"
		return 0
	fi
	if [[ "$direction" == "=" || "$direction" == "0" ]] && [[ $force_rename -eq 0 ]]; then
		echo "ok    $category/$gname: $baseline and $current_pv compare equal"
		return 0
	fi
	if [[ "$direction" == "?" && $force_rename -eq 0 ]]; then
		echo "skip  $category/$gname: $baseline -> $current_pv but vercmp is unavailable; refusing an unverifiable rename"
		DRIFT=1
		return 0
	fi

	local old_pv new_pv
	old_pv=$(gentoo_version "$baseline")
	new_pv=$(gentoo_version "$current_pv")
	if [[ "$mode" == check ]]; then
		echo "drift $category/$gname: $baseline -> $current_pv (run: bin/sync-gentoo $package)"
		DRIFT=1
		return 0
	fi

	local target="$dir/$gname-$new_pv.ebuild"
	if [[ -e "$target" ]]; then
		echo "skip  $category/$gname: $gname-$new_pv.ebuild already exists"
		return 0
	fi
	mv "$ebuild" "$target"
	# Update or insert the baseline marker at the top of the renamed ebuild.
	if grep -q '^# arch-pkgver:' "$target"; then
		sed -i "s|^# arch-pkgver:.*|$MARKER $current_pv|" "$target"
	else
		sed -i "1i $MARKER $current_pv" "$target"
	fi
	if grep -qF -- "$old_pv" "$target"; then
		echo "bump  $category/$gname: renamed to $new_pv BUT '$old_pv' still appears inside; update pinned URLs by hand"
	else
		echo "bump  $category/$gname: renamed to $new_pv"
	fi
}

cmd_sync() {
	local mode="$1"
	shift
	local rows=()
	if (( $# )); then
		# Explicit packages: resolve each through the location table.
		local package row
		for package in "$@"; do
			row=$(gentoo_location "$package")
			if [[ -z "$row" ]]; then
				echo "skip  $package: no row in $PACKAGES_TSV"
				continue
			fi
			rows+=("$package"$'\t'"${row%/*}"$'\t'"${row#*/}")
		done
	else
		rows=$(awk -F'\t' 'NF >= 3 && $1 !~ /^#/ { print $1 "\t" $2 "\t" $3 }' "$PACKAGES_TSV")
	fi

	DRIFT=0
	local row failed=0
	while IFS= read -r row; do
		[[ -n "$row" ]] || continue
		if ! sync_one "$(cut -f1 <<<"$row")" "$(cut -f2 <<<"$row")" "$(cut -f3 <<<"$row")" "$mode"; then
			((++failed))
		fi
	done <<<"$(printf '%s\n' "${rows[@]}" 2>/dev/null || true)"

	if (( failed )); then
		echo "$failed package(s) failed" >&2
		return 1
	fi
	if [[ "$mode" == check && $DRIFT -eq 1 ]]; then
		return 1
	fi
}

cmd_self_test() {
	local failures=0
	check() {
		if [[ "$2" == "$3" ]]; then
			echo "ok - $1"
		else
			echo "not ok - $1: expected [$2] got [$3]" >&2
			((++failures))
		fi
	}

	# Fixture tree: the script derives BUILD_ROOT from its own location, so
	# the fixture gets a copy of the whole tool surface it sources.
	local fixture
	fixture=$(mktemp -d)
	mkdir -p "$fixture/bin" "$fixture/helpers" "$fixture/omarchy-pkgs/pkgbuilds/fixture" \
		"$fixture/omarchy-pkgs/helpers" "$fixture/gentoo/app-misc/fixture"
	for f in gentoo.sh gentoo-deps.map gentoo-packages.tsv; do
		cp "$BUILD_ROOT/helpers/$f" "$fixture/helpers/"
	done
	cp "$UPSTREAM_ROOT/helpers/package-metadata.sh" "$fixture/omarchy-pkgs/helpers/"
	cp "${BASH_SOURCE[0]}" "$fixture/bin/sync-gentoo"
	printf '%s\n' "fixture	app-misc	fixture" >>"$fixture/helpers/gentoo-packages.tsv"
	printf '%s\n' \
		"pkgname=fixture" "pkgver=1.0.0" "pkgrel=1" "arch=('any')" \
		"license=('MIT')" "url='https://example.com'" \
		>"$fixture/omarchy-pkgs/pkgbuilds/fixture/PKGBUILD"

	local ebuild="$fixture/gentoo/app-misc/fixture/fixture-1.0.0.ebuild"
	printf '%s\n' \
		"# arch-pkgver: 1.0.0" \
		"EAPI=8" \
		'DESCRIPTION="fixture"' \
		"SRC_URI=\"https://example.com/dl/fixture-1.0.0.tar.gz\"" \
		>"$ebuild"
	check "marker parsed" "1.0.0" "$(marker_pkgver "$ebuild")"

	# No drift: check passes.
	(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1)
	check "no drift exits 0" "0" "$?"

	# Upstream moves: check reports drift. With vercmp available, sync renames
	# and rewrites the marker; without it, the direction cannot be verified
	# and sync must refuse rather than guess. (rc captured by hand: several of
	# these commands are EXPECTED to fail, and the self-test runs set -e.)
	printf '%s\n' "pkgname=fixture" "pkgver=1.1.0" "pkgrel=1" "arch=('any')" \
		"license=('MIT')" "url='https://example.com'" \
		>"$fixture/omarchy-pkgs/pkgbuilds/fixture/PKGBUILD"
	rc=0
	(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1) || rc=$?
	check "drift exits 1" "1" "$rc"
	if have_vercmp; then
		local bump_out
		bump_out=$(cd "$fixture" && ./bin/sync-gentoo fixture 2>&1) || true
		check "ebuild renamed to 1.1.0" "yes" \
			"$([[ -f "$fixture/gentoo/app-misc/fixture/fixture-1.1.0.ebuild" ]] && echo yes || echo no)"
		check "marker rewritten" "1.1.0" "$(marker_pkgver "$fixture/gentoo/app-misc/fixture/fixture-1.1.0.ebuild")"
		check "stale pin flagged" "1" "$(grep -c 'update pinned URLs by hand' <<<"$bump_out")"
		(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1)
		check "back in sync exits 0" "0" "$?"

		# Recipe older than the ebuild: left alone.
		printf '%s\n' "pkgname=fixture" "pkgver=0.9.0" "pkgrel=1" "arch=('any')" \
			"license=('MIT')" "url='https://example.com'" \
			>"$fixture/omarchy-pkgs/pkgbuilds/fixture/PKGBUILD"
		(cd "$fixture" && ./bin/sync-gentoo fixture >/dev/null 2>&1)
		check "older recipe does not downgrade" "yes" \
			"$([[ -f "$fixture/gentoo/app-misc/fixture/fixture-1.1.0.ebuild" ]] && echo yes || echo no)"

		# No arguments: the documented "every row in the table" sync. This
		# guards the dispatch - the empty-args path used to be a silent
		# no-op and the upstream-sync automation shipped months of renames
		# that never landed.
		printf '%s\n' "pkgname=fixture" "pkgver=1.2.0" "pkgrel=1" "arch=('any')" \
			"license=('MIT')" "url='https://example.com'" \
			>"$fixture/omarchy-pkgs/pkgbuilds/fixture/PKGBUILD"
		(cd "$fixture" && ./bin/sync-gentoo >/dev/null 2>&1)
		check "no-args sync renames every drifted row" "yes" \
			"$([[ -f "$fixture/gentoo/app-misc/fixture/fixture-1.2.0.ebuild" ]] && echo yes || echo no)"
	else
		(cd "$fixture" && ./bin/sync-gentoo fixture >/dev/null 2>&1)
		check "no vercmp: refuses to rename" "yes" \
			"$([[ -f "$fixture/gentoo/app-misc/fixture/fixture-1.0.0.ebuild" ]] && echo yes || echo no)"
	fi

	# Marker matches the recipe but the file name skipped gentoo_version (the
	# 2026-09 "+build"/".BETA" automation renames portage could not parse at
	# all): the "ok" fast path must not bless it. Runs with or without vercmp
	# - the versions are identical, so no upgrade direction is involved.
	printf '%s\n' "pkgname=fixture" "pkgver=26.9.6+build89647" "pkgrel=1" "arch=('any')" \
		"license=('MIT')" "url='https://example.com'" \
		>"$fixture/omarchy-pkgs/pkgbuilds/fixture/PKGBUILD"
	rm -f "$fixture"/gentoo/app-misc/fixture/*.ebuild
	printf '%s\n' \
		"# arch-pkgver: 26.9.6+build89647" \
		"EAPI=8" \
		'DESCRIPTION="fixture"' \
		>"$fixture/gentoo/app-misc/fixture/fixture-26.9.6+build89647.ebuild"
	rc=0
	(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1) || rc=$?
	check "non-PMS file name reported as drift" "1" "$rc"
	(cd "$fixture" && ./bin/sync-gentoo fixture >/dev/null 2>&1)
	check "non-PMS file name renamed to the mangling" "yes" \
		"$([[ -f "$fixture/gentoo/app-misc/fixture/fixture-26.9.6_p89647.ebuild" ]] && echo yes || echo no)"
	check "marker kept the raw Arch version" "26.9.6+build89647" \
		"$(marker_pkgver "$fixture/gentoo/app-misc/fixture/fixture-26.9.6_p89647.ebuild")"
	(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1)
	check "renamed row back in sync" "0" "$?"

	# A hand-simplified but PMS-valid name (dropped commit hash, Gentoo -r
	# bump) is deliberate, not drift: only names portage cannot parse are.
	rm -f "$fixture"/gentoo/app-misc/fixture/*.ebuild
	printf '%s\n' \
		"# arch-pkgver: 26.9.6+build89647" \
		"EAPI=8" \
		'DESCRIPTION="fixture"' \
		>"$fixture/gentoo/app-misc/fixture/fixture-26.9.6-r1.ebuild"
	(cd "$fixture" && ./bin/sync-gentoo --check >/dev/null 2>&1)
	check "hand-simplified PMS-valid name is not drift" "0" "$?"

	rm -rf "$fixture"

	if ((failures)); then
		echo "$failures self-test failure(s)" >&2
		exit 1
	fi
	echo "all self-tests passed"
}

usage() {
	sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

if [[ "${1:-}" == --self-test ]]; then
	cmd_self_test
elif [[ "${1:-}" == --check ]]; then
	shift
	cmd_sync check "$@"
elif [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
	usage
elif [[ "${1:-}" == "" ]]; then
	# No arguments: the documented "every row in the table" sync. (This
	# dispatch used to be a silent no-op — the upstream-sync automation ran
	# it for months without a single rename landing.)
	cmd_sync sync
else
	cmd_sync sync "$@"
fi
